#!/usr/bin/env python3
"""repo-inventory: what an external skill repo would add, before loading it (load-repo skill step 3)

    python3 systems/repo-inventory "<repo dir>" [--out skills/systems/repos/<name>.json]

per SKILL.md: name · description chars (= prompt cost every turn) · file size · harness-only refs (cursor/codex/claude-specific)
  · clash (same name as an own / linked skill → never link) · overlap (own skill with the most shared description words)
prints a table + totals (skills, disk, prompt tokens if all loaded)      you then fill keep: true/false + why per row in the json
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
LINKED = [Path.home() / '.hermes/cs-code-skills', Path.home() / '.hermes/skills']
HARNESS = re.compile(r'\bcursor\b|generalPurpose|subagent_type|\.cursor/|composer', re.I)
STOP = set('that this with when from your into what each them then have only before after which about their there where use used using skill skills'.split())


def front(text):
    m = re.match(r'---\n(.*?)\n---', text, re.S)
    head = m.group(1) if m else ''
    get = lambda k: (re.search(rf'^{k}:\s*(.*)$', head, re.M) or [None, ''])[1].strip().strip('"')
    return get('name'), get('description')


def words(t):
    return {w for w in re.findall(r'[a-z]{4,}', t.lower()) if w not in STOP}


def own_skills(skip):
    out = {}
    for base in LINKED:
        for f in base.glob('**/SKILL.md'):
            real = f.resolve()
            if skip in real.parents:
                continue
            try:
                n, d = front(real.read_text(errors='ignore'))
            except OSError:
                continue
            if n:
                out[n] = d
    return out


def inventory(repo):
    repo = Path(repo).resolve()
    own = own_skills(repo)
    rows = []
    for f in sorted(repo.glob('**/SKILL.md')):
        if '.git' in f.parts:
            continue
        t = f.read_text(errors='ignore')
        n, d = front(t)
        w = words(d)
        best = max(((len(w & words(od)), on) for on, od in own.items()), default=(0, ''))
        rows.append({'name': n, 'path': str(f.parent.relative_to(repo)), 'desc_chars': len(d), 'bytes': len(t),
                     'harness_refs': len(HARNESS.findall(t)), 'clash': n in own,
                     'overlap': best[1] if best[0] >= 4 else '', 'overlap_words': best[0], 'keep': None, 'why': ''})
    du = subprocess.run(['du', '-sk', str(repo)], capture_output=True, text=True).stdout.split()[0]
    return {'repo': str(repo), 'generated': time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'disk_kb': int(du), 'skills': len(rows),
            'all_desc_chars': sum(r['desc_chars'] for r in rows), 'rows': rows}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('repo'); ap.add_argument('--out')
    a = ap.parse_args()
    t0 = time.time()
    inv = inventory(a.repo)
    inv['seconds'] = round(time.time() - t0, 2)
    for r in inv['rows']:
        flag = 'CLASH' if r['clash'] else ('dup?' + r['overlap'] if r['overlap'] else '')
        print(f"{r['name'][:34]:34} {r['desc_chars']:5} {r['harness_refs']:3}  {flag}")
    print(f"{inv['skills']} skills · {inv['disk_kb'] // 1024} MB · all descriptions {inv['all_desc_chars']} chars ≈ {inv['all_desc_chars'] // 4} tokens per prompt · {inv['seconds']}s")
    if a.out:
        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
        Path(a.out).write_text(json.dumps(inv, indent=1, ensure_ascii=False) + '\n')
    return 0


if __name__ == '__main__':
    sys.exit(main())
