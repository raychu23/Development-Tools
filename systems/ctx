#!/usr/bin/env python3
"""ctx: raymond's idea-tree engine (rules.md §10, T2 c bot-platform P1 + P2)

files + git are the only truth. every action edits plain md files, never deletes, and makes 1 small git commit.
actions run under a repo lock, check before they write, and roll back their own edits when anything fails.

    tree     [scope] [--json]                 task tree: folders with 0 start.md (c / o / d subideas, agents) + notes with carry:
    board    [scope] [--json]                 every bot (T<n>-a<n>-* folders + any 0 start with owner:) with status, heartbeat, next, needs-you
    boot     <task> [--max-chars N]           boot pack: 0 start in full + pinned notes in full + inbox      read-only
    pin      <note> [--text T]                note → carry: pin      with --text: add T to the task's pinned row
    auto     <note>                           note → carry: auto (the default: listed, not loaded in full)
    drop     <note> [--text T]                note → carry: drop      with --text: move the matching 0 start line into 4 log/dropped.md (dated)
    merge-up <note> [--text T]                copy key lines (goal · status, or T) into the parent 0 start "merged up" row
    relegate <c folder> [--dead] [--no-merge] merge up, then c <x> → o <x> (or d <x>) by git mv, links in the task fixed, nothing deleted
    rotate   <task> [--session S]             session log row in 4 log/sessions.md, frontmatter session cleared, prints boot pack
    send     <task> <text> [--from F]         append a dated q row to the target's inbox block (bot ↔ bot)
    set      <note> key=value ...             frontmatter fields (status owner next session …)
    beat     <task> [--session S] [--harness H] [--event E] [--status T] [--next T]
                                              heartbeat → systems/state/beats.json (git-ignored, no commit)      --status / --next also set frontmatter + commit

global: --root DIR (else $CTX_ROOT, else the folder above systems/)      --no-commit      --include-dirty (allow editing a file that has uncommitted edits)
commit author: $CTX_GIT_NAME / $CTX_GIT_EMAIL (default "Raymond Chu" / "")      trailers: $CTX_TRAILERS (newline separated) + --trailer
"""
import argparse
