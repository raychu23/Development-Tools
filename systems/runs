#!/usr/bin/env python3
"""runs: read-only list of hermes sessions      parents · their delegate_task children · cron runs · orphans

    python3 systems/runs [--since DAYS] [--session ID] [--orphans] [--json] [--stale-hours H] [--hermes-home DIR]

parents        top-level sessions (no parent_session_id) active in the window, children nested under them (any depth)
children       delegate_task subagents (title 'Subagent: …', parent_session_id set), kind 'subagent'
               parent_session_id also links /branch children (kind 'branch': model_config _branched_from or parent ended
               'branched') and compression continuations (kind 'continuation': parent ended 'compression')
cron           sessions with source 'cron' (id cron_<job>_<YYYYmmdd_HHMMSS>) + every fire in cron/executions.db
               (script-only fires have no session, so the execution row is their only record)
status         running · ended · orphaned
               orphaned = a subagent still open while its parent has ended, or a subagent / cron run open longer
               than --stale-hours (default 6) with no activity (last_activity_at, else started_at)
               branches and continuations outlive their parent by design: never orphaned for that
Reads only: state.db and executions.db are opened with sqlite URI mode=ro (immutable=1 when a lock/WAL blocks that).
A missing db is an empty result, not an error.
"""
import argparse
import datetime as dt
import json
import math
import os
import re
import sqlite3
import sys
import time

sys.dont_write_bytecode = True

CRON_ID = re.compile(r'^cron_(.+)_\d{8}_\d{6}$')
COLS = ('id', 'parent_session_id', 'title', 'source', 'started_at', 'ended_at', 'end_reason', 'message_count',
        'tool_call_count', 'estimated_cost_usd', 'actual_cost_usd', 'last_activity_at', 'model', 'cwd', 'model_config')
EXEC_COLS = ('id', 'job_id', 'source', 'status', 'claimed_at', 'started_at', 'finished_at', 'error', 'progress_at',
             'delivery_outcome')


def connect(path):
    """read-only connection or None (missing file)      falls back to immutable=1 when mode=ro cannot open (lock, WAL without -shm)"""
    if not os.path.isfile(path):
        return None
    uri = 'file:' + path.replace('?', '%3f').replace('#', '%23')
    last = None
    for opts in ('mode=ro', 'mode=ro&immutable=1'):
        try:
            con = sqlite3.connect(f'{uri}?{opts}', uri=True, timeout=2)
            con.row_factory = sqlite3.Row
            con.execute('select count(*) from sqlite_master').fetchone()
            return con
        except sqlite3.Error as e:
            last = e
    raise last


def columns(con, table):
    return {r[1] for r in con.execute(f'pragma table_info({table})')}


def epoch(ts):
    """the one timestamp parser: epoch number, numeric string or ISO string → epoch float · empty / unparseable → None"""
    if ts is None or isinstance(ts, bool):
        return None
    if isinstance(ts, bytes):
        ts = ts.decode('utf-8', 'replace')
    try:
        if isinstance(ts, str):
            ts = ts.strip()
            if not ts:
                return None
            try:
                v = float(ts)
            except ValueError:
                v = dt.datetime.fromisoformat(ts).timestamp()  # naive = local time
        else:
            v = float(ts)
    except (ValueError, TypeError, OverflowError, OSError):
        return None
    return v if math.isfinite(v) else None


def iso(ts):
    """any timestamp → local 'YYYY-MM-DD HH:MM:SS' · None / '' stay None · unparseable is shown as-is"""
    if ts is None or ts == '':
        return None
    v = epoch(ts)
    try:
        return dt.datetime.fromtimestamp(v).strftime('%Y-%m-%d %H:%M:%S') if v is not None else str(ts)
    except (ValueError, OSError, OverflowError):
        return str(ts)


def last_seen(*stamps):
    """first non-empty stamp → (epoch, note) · unparseable gives (None, note) so the stale check is skipped, never a crash"""
    for name, ts in stamps:
        if ts is None or (isinstance(ts, str) and not ts.strip()):
            continue
        v = epoch(ts)
        return (v, '') if v is not None else (None, f'stale check skipped: unreadable {name} {str(ts)[:40]!r}')
    return None, ''


def load_sessions(con, cutoff, session=None):
    have = columns(con, 'sessions')
    if not have:
        return {}
    sel = ', '.join(c if c in have else f'null as {c}' for c in COLS)
    act = 'coalesce(last_activity_at, ended_at, started_at)' if 'last_activity_at' in have else 'coalesce(ended_at, started_at)'
    if session:
        rows = con.execute(f'select {sel} from sessions').fetchall()
    else:
        rows = con.execute(f'select {sel} from sessions where started_at >= ? or {act} >= ? '
                           "or (ended_at is null and (parent_session_id is not null or source = 'cron'))",
                           (cutoff, cutoff)).fetchall()
    out = {r['id']: dict(r) for r in rows}
    # pull in parents of rows in the window that started before it, so every child has its tree
    missing = {r['parent_session_id'] for r in out.values() if r['parent_session_id'] and r['parent_session_id'] not in out}
    while missing:
        q = ','.join('?' * len(missing))
        got = [dict(r) for r in con.execute(f'select {sel} from sessions where id in ({q})', tuple(missing))]
        for r in got:
            out[r['id']] = r
        missing = {r['parent_session_id'] for r in got if r['parent_session_id'] and r['parent_session_id'] not in out}
    return out


def load_executions(path, cutoff):
    con = connect(path)
    if con is None:
        return []
    try:
        have = columns(con, 'executions')
        if not have:
            return []
        sel = ', '.join(c if c in have else f'null as {c}' for c in EXEC_COLS)
        rows = [dict(r) for r in con.execute(f'select {sel} from executions')]
    finally:
        con.close()
    return [r for r in rows if (epoch(r['finished_at']) or epoch(r['progress_at']) or epoch(r['started_at'])
                                or epoch(r['claimed_at']) or 0) >= cutoff or r['status'] in ('claimed', 'running')]


def kind(s, parent):
    if not s['parent_session_id']:
        return 'cron' if s['source'] == 'cron' else 'top'
    if '_branched_from' in (s['model_config'] or '') or (parent and parent['end_reason'] == 'branched'):
        return 'branch'
    if parent and parent['end_reason'] == 'compression':
        return 'continuation'
    return 'subagent'


def session_status(s, parent, now, stale_h):
    k = kind(s, parent)
    if s['ended_at'] is not None:
        return 'ended', ''
    if k == 'subagent' and parent is not None and parent['ended_at'] is not None:
        return 'orphaned', 'parent ended ' + iso(parent['ended_at'])
    if k in ('subagent', 'cron'):
        last, note = last_seen(('last_activity_at', s['last_activity_at']), ('started_at', s['started_at']))
        if last is not None and now - last > stale_h * 3600:
            return 'orphaned', f'no activity for {(now - last) / 3600:.1f} h'
        return 'running', note
    return 'running', ''


def row(s, sessions, now, stale_h):
    parent = sessions.get(s['parent_session_id']) if s['parent_session_id'] else None
    status, why = session_status(s, parent, now, stale_h)
    cost = s['actual_cost_usd'] if s['actual_cost_usd'] is not None else s['estimated_cost_usd']
    return {'id': s['id'], 'parent': s['parent_session_id'], 'kind': kind(s, parent), 'title': s['title'] or '', 'source': s['source'],
            'started': iso(s['started_at']), 'ended': iso(s['ended_at']), 'end_reason': s['end_reason'],
            'last_activity': iso(s['last_activity_at']), 'messages': s['message_count'], 'tool_calls': s['tool_call_count'],
            'cost_usd': cost, 'status': status, 'why': why, 'children': []}


def exec_row(e, now, stale_h):
    st = e['status']
    status, why = ('running', '') if st in ('claimed', 'running') else ('ended', '')
    if status == 'running':
        last, why = last_seen(('progress_at', e['progress_at']), ('started_at', e['started_at']), ('claimed_at', e['claimed_at']))
        if last is not None and now - last > stale_h * 3600:
            status, why = 'orphaned', f'{st} with no progress for {(now - last) / 3600:.1f} h'
    return {'id': e['id'], 'job_id': e['job_id'], 'source': e['source'], 'execution_status': st,
            'started': iso(e['started_at'] or e['claimed_at']), 'ended': iso(e['finished_at']),
            'end_reason': e['error'] or st, 'delivery': e['delivery_outcome'], 'session': None, 'status': status, 'why': why}


def build(home, since=7.0, session=None, orphans=False, stale_h=6.0, now=None):
    now = time.time() if now is None else now
    cutoff = now - since * 86400
    db = os.path.join(home, 'state.db')
    view = {'db': db, 'missing': False, 'since_days': since, 'session': session, 'errors': [],
            'parents': [], 'cron': [], 'cron_executions': [], 'orphans': [], 'counts': {}}
    con = None
    try:
        con = connect(db)
        if con is None:
            view['missing'] = True
            sessions = {}
        else:
            sessions = load_sessions(con, cutoff, session)
    except sqlite3.Error as e:
        view['errors'].append(f'state.db unreadable: {type(e).__name__}: {e}'[:300])
        sessions = {}
    finally:
        if con is not None:
            con.close()
    try:
        execs = load_executions(os.path.join(home, 'cron', 'executions.db'), cutoff) if session is None else []
    except sqlite3.Error as e:
        view['errors'].append(f'cron/executions.db unreadable: {type(e).__name__}: {e}'[:300])
        execs = []

    rows = {sid: row(s, sessions, now, stale_h) for sid, s in sessions.items()}
    roots = []
    for sid, r in sorted(rows.items(), key=lambda kv: epoch(sessions[kv[0]]['started_at']) or 0):
        p = r['parent']
        if p and p in rows:
            rows[p]['children'].append(r)
        else:
            roots.append(r)

    if session:
        hit = rows.get(session) or next((r for k, r in rows.items() if k.startswith(session)), None)
        if hit is None:
            view['errors'].append(f'no session {session}')
            roots = []
        else:
            while hit['parent'] and hit['parent'] in rows:
                hit = rows[hit['parent']]
            roots = [hit]

    def walk(r):
        yield r
        for c in r['children']:
            yield from walk(c)

    view['orphans'] = [{k: v for k, v in r.items() if k != 'children'} for root in roots for r in walk(root) if r['status'] == 'orphaned']
    cron_roots = [r for r in roots if r['source'] == 'cron']
    view['parents'] = [r for r in roots if r['source'] != 'cron']
    view['cron'] = cron_roots

    # each execution → the cron session of the same job that started within 2 min of it (agent fires write both)
    by_job = {}
    for r in cron_roots:
        m = CRON_ID.match(r['id'])
        if m:
            by_job.setdefault(m.group(1), []).append(r)
    for e in execs:
        x = exec_row(e, now, stale_h)
        t = epoch(e['started_at']) or epoch(e['claimed_at'])
        for r in by_job.get(e['job_id'], []):
            rt = epoch(sessions[r['id']]['started_at'])
            if t is not None and rt is not None and abs(rt - t) <= 120:
                x['session'] = r['id']
                r['execution'] = {'id': x['id'], 'status': x['execution_status'], 'delivery': x['delivery']}
                break
        view['cron_executions'].append(x)
        if x['status'] == 'orphaned':
            view['orphans'].append({k: v for k, v in x.items()})
    view['cron_executions'].sort(key=lambda x: x['started'] or '')

    if orphans:
        bad = {o['id'] for o in view['orphans']}

        def prune(r):
            kids = [k for k in (prune(c) for c in r['children']) if k]
            if r['id'] in bad or kids:
                return dict(r, children=kids)
            return None

        view['parents'] = [p for p in (prune(r) for r in view['parents']) if p]
        view['cron'] = [p for p in (prune(r) for r in view['cron']) if p]
        view['cron_executions'] = [x for x in view['cron_executions'] if x['status'] == 'orphaned']

    every = [r for root in view['parents'] + view['cron'] for r in walk(root)]
    view['counts'] = {'parents': len(view['parents']), 'children': sum(1 for r in every if r['parent']),
                      'subagents': sum(r['kind'] == 'subagent' for r in every),
                      'cron_sessions': len(view['cron']), 'cron_executions': len(view['cron_executions']),
                      'running': sum(r['status'] == 'running' for r in every),
                      'ended': sum(r['status'] == 'ended' for r in every),
                      'orphaned': len(view['orphans'])}
    return view


def short(s, n=48):
    s = ' '.join((s or '').split())
    return s if len(s) <= n else s[:n - 1] + '…'


def hm(stamp):
    return stamp[5:16] if stamp else '—'


def line(r, indent):
    cost = f"      ${r['cost_usd']:.2f}" if r.get('cost_usd') else ''
    why = f"      {r['why']}" if r.get('why') else ''
    end = f"      {r['end_reason']}" if r.get('end_reason') and r['status'] == 'ended' else ''
    ex = f"      exec {r['execution']['status']}" if r.get('execution') else ''
    k = f"      {r['kind']}" if r['kind'] in ('branch', 'continuation') else ''
    return (f"{' ' * indent}{r['status']:<9} {r['id']}      {short(r['title'])}{k}      {r['source']}      "
            f"{hm(r['started'])} → {hm(r['ended'])}      {r['tool_calls'] or 0} tools{cost}{end}{ex}{why}")


def text(view):
    c = view['counts']
    head = f"runs      last {view['since_days']:g} days" if not view['session'] else f"runs      session {view['session']}"
    lines = ['```notes', f"{head}      {c['parents']} parents · {c['children']} children ({c['subagents']} subagents) · {c['cron_sessions']} cron sessions · "
                         f"{c['cron_executions']} cron fires · {c['orphaned']} orphaned"]
    lines += [f'    error      {e}' for e in view['errors']]
    if view['missing']:
        lines.append(f"    no hermes state db at {view['db']}      nothing to list")

    def tree(r, indent):
        lines.append(line(r, indent))
        for ch in r['children']:
            tree(ch, indent + 4)

    lines.append('    parents' if view['parents'] else '    no parent sessions')
    for p in view['parents']:
        tree(p, 8)
    if view['cron'] or view['cron_executions']:
        lines.append('    cron')
        for p in view['cron']:
            tree(p, 8)
        for x in view['cron_executions']:
            if x['session']:
                continue  # shown on its session row
            why = f"      {x['why']}" if x['why'] else ''
            lines.append(f"        {x['status']:<9} {x['id']}      job {x['job_id']}      {x['source']}      "
                         f"{hm(x['started'])} → {hm(x['ended'])}      {x['end_reason']}{why}")
    if view['orphans']:
        lines.append('    orphans')
        lines += [f"        {o['id']}      {short(o.get('title') or o.get('job_id') or '', 40)}      {o['why']}" for o in view['orphans']]
    lines.append('```')
    return '\n'.join(l.replace(';', ',') for l in lines) + '\n'  # notes style: no semicolons


def main(argv=None):
    p = argparse.ArgumentParser(description='read-only hermes runs: parents, delegate_task children, cron runs, orphans')
    p.add_argument('--hermes-home', default=os.environ.get('HERMES_HOME') or os.path.expanduser('~/.hermes'))
    p.add_argument('--since', type=float, default=7.0, metavar='DAYS')
    p.add_argument('--session', metavar='ID', help='one parent tree (any id in it, or a unique id prefix)')
    p.add_argument('--orphans', action='store_true', help='only orphaned runs (with their parents for context)')
    p.add_argument('--stale-hours', type=float, default=6.0, metavar='H')
    p.add_argument('--json', action='store_true')
    a = p.parse_args(argv)
    if a.since <= 0 or a.stale_hours <= 0:
        p.error('--since and --stale-hours must be more than 0')
    view = build(os.path.expanduser(a.hermes_home), a.since, a.session, a.orphans, a.stale_hours)
    sys.stdout.write(json.dumps(view, ensure_ascii=False) + '\n' if a.json else text(view))
    return 0


if __name__ == '__main__':
    sys.exit(main())
