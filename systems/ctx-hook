#!/usr/bin/env python3
"""ctx-hook: 1 hook script for claude code + codex (rules.md §10, T2 c bot-platform P1)

    python3 "<CS Code>/systems/ctx-hook" session-start | prompt | pre-compact | stop      (hook json on stdin)

which bot: $CTX_TASK (task folder, absolute or relative to CS Code), else the session cwd when it sits inside a task folder
no bot found → prints nothing, exits 0 (plain sessions are untouched)

    session-start      boot pack (ctx boot) as additionalContext + heartbeat with session id      after a compaction: + "re-ground, refresh 0 start"
    prompt             context gauge from the transcript: nudge once per level at 55% (refresh 0 start) and 70% (rotate)
    pre-compact        heartbeat event precompact (the 55 / 70 nudges are what get 0 start rewritten before this point)
    stop               heartbeat (presence for the board / idea-tree band)

configured failures are visible in hook json + stderr, while the native hook
exits 0 so a missing integration does not pretend to enforce harness execution
"""
import importlib.machinery
import importlib.util
import json
import os
import sys

sys.dont_write_bytecode = True  # no __pycache__ beside the scripts
HERE = os.path.dirname(os.path.realpath(__file__))
if '--native' in sys.argv:
    from native_activation import hook_main
    sys.exit(hook_main([arg for arg in sys.argv[1:] if arg != '--native']))
try:
    _loader = importlib.machinery.SourceFileLoader('ctx', os.path.join(HERE, 'ctx'))
    _spec = importlib.util.spec_from_loader('ctx', _loader)
    ctx = importlib.util.module_from_spec(_spec)
    _loader.exec_module(ctx)
except Exception as _e:  # a hook must never break the session
    print(f'ctx-hook: cannot load systems/ctx: {type(_e).__name__}: {_e}', file=sys.stderr)
    if os.environ.get('CTX_TASK'):
        print(json.dumps({'systemMessage': 'CTX TASK LOAD FAILED: systems/ctx unavailable. Do not act on managed work until the task contract and current packet can be read.'}))
    sys.exit(0)

LEVELS = (70, 55)
CONFIGURED = False
NUDGE = {
    55: 'context gauge {pct}% full: refresh {start} now (status · next · decisions), commit it      long content → its doc, not the chat',
    70: 'context gauge {pct}% full: rotate now      1 refresh {start} from observed work and commit      2 python3 systems/ctx rotate "{task}"      3 manually start a fresh session with the resulting packet      rotate prepares context, it does not launch a session',
}


def root():
    return ctx.find_root(None)


def find_task(r, data):
    t = os.environ.get('CTX_TASK')
    if t:
        p = t if os.path.isabs(t) else os.path.join(r, t)
        return ctx.task_of(r, os.path.normpath(p))
    cwd = data.get('cwd') or os.getcwd()
    cwd = os.path.normpath(os.path.abspath(cwd))
    if cwd == os.path.normpath(r) or not cwd.startswith(os.path.normpath(r) + os.sep):
        return None
    try:
        t = ctx.task_of(r, cwd)
    except ctx.CtxError:
        return None
    # only a real bot folder (T<n>-…, T<n>-a<n>-…, c / o / d subidea) gets a boot pack, not a topic or project folder
    return t if ctx.kind_of(os.path.basename(t)) != 'folder' else None


def harness(data):
    tp = data.get('transcript_path') or ''
    return 'codex' if '/.codex/' in tp or os.environ.get('CODEX_HOME') and tp.startswith(os.environ['CODEX_HOME']) else 'claude-code'


def emit(event, text):
    print(json.dumps({'hookSpecificOutput': {'hookEventName': event, 'additionalContext': text}}))


def visible_failure(event, error):
    text = f'CTX TASK LOAD FAILED: {type(error).__name__}: {error}\nDo not act on configured work until its current task contract and packet are readable. No successful boot or revision acknowledgement is claimed.'
    if event in ('session-start', 'prompt'):
        emit('SessionStart' if event == 'session-start' else 'UserPromptSubmit', text)
    else:
        print(json.dumps({'systemMessage': text}))


def managed_task(r, task):
    """A legacy task becomes managed only through an explicit engine contract."""
    path = os.path.realpath(task)
    while path.startswith(os.path.realpath(r) + os.sep):
        if os.path.isfile(os.path.join(path, 'systems', 'task.json')):
            return path
        path = os.path.dirname(path)
    return None


def lines_backwards(path, chunk=1 << 20, limit=256 << 20):
    """yield the file's lines from the end, reading chunk by chunk (a huge tool result line does not hide the last usage line)"""
    with open(path, 'rb') as f:
        f.seek(0, 2)
        pos = f.tell()
        rest = b''
        read_total = 0
        while pos > 0 and read_total < limit:
            step = min(chunk, pos)
            pos -= step
            f.seek(pos)
            buf = f.read(step) + rest
            read_total += step
            parts = buf.split(b'\n')
            rest = parts[0]
            for line in reversed(parts[1:]):
                if line.strip():
                    yield line.decode('utf-8', 'replace')
        if rest.strip() and pos == 0:
            yield rest.decode('utf-8', 'replace')


def usage(data):
    """(tokens in the window, window size) from the transcript, or None"""
    tp = data.get('transcript_path')
    if not tp or not os.path.isfile(tp):
        return None
    for line in lines_backwards(tp):
        if 'compact_boundary' in line or '"type":"compacted"' in line.replace(' ', ''):
            return None  # usage before a compaction says nothing about the window now
        if '"usage"' not in line and 'token_count' not in line:
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        # codex rollout: event_msg / token_count
        p = o.get('payload') if isinstance(o.get('payload'), dict) else None
        if p and p.get('type') == 'token_count' and isinstance(p.get('info'), dict):
            info = p['info']
            last = info.get('last_token_usage') or {}
            used = last.get('input_tokens', 0) + last.get('output_tokens', 0)
            win = info.get('model_context_window') or int(os.environ.get('CTX_WINDOW', 272000))
            if used:
                return used, win
        # claude code transcript: assistant message usage
        m = o.get('message') if isinstance(o.get('message'), dict) else None
        u = m.get('usage') if m else None
        if isinstance(u, dict) and o.get('type') == 'assistant' and not o.get('isSidechain'):
            used = sum(u.get(k, 0) or 0 for k in ('input_tokens', 'cache_creation_input_tokens', 'cache_read_input_tokens', 'output_tokens'))
            model = str(data.get('model') or m.get('model') or '')
            win = int(os.environ.get('CTX_WINDOW') or (1_000_000 if '1m' in model.lower() else 200_000))
            if used:
                return used, win
    return None


def main(argv):
    global CONFIGURED
    ev = argv[1] if len(argv) > 1 else ''
    try:
        data = json.loads(sys.stdin.read() or '{}')
    except ValueError:
        data = {}
    r = root()
    task = find_task(r, data)
    if not task:
        return 0
    CONFIGURED = True
    rel = ctx.rel(r, task)
    start = os.path.join(rel, '0 start.md')
    sid = data.get('session_id') or ''
    h = harness(data)
    if ev == 'session-start':
        src = data.get('source') or 'startup'
        # a compaction empties the window: the gauge starts over for this session
        extra = {'gauge_level': 0, 'gauge_session': sid}
        # claude code saves additionalContext over 10,000 chars to a file (preview only)      codex caps hook output at ~2,500 tokens
        cap = int(os.environ.get('CTX_BOOT_MAX', 9500))
        head = f'you are the bot for {rel} (rules.md §10)      boot pack below, injected by systems/ctx-hook\n'
        if src == 'compact':
            head += f'this session was just compacted: re-ground on the pack below, then reconcile {start} with actual files and observed work before refreshing status or next\n'
        managed = managed_task(r, task)
        if managed:
            from agent_core import make_boot
            pack = make_boot(r, managed, max_chars=max(1, cap - len(head) - 1), persist=False)
            manifest = pack['manifest']
            # Emitted context is not proof the model read it. Explicit acknowledge
            # through the managed engine remains the authority for a loaded rev.
            extra.update(boot_manifest=manifest, boot_emitted_revision=manifest.get('requirement_rev'), boot_blocked=bool(manifest.get('blocked')))
            if manifest.get('blocked'):
                head = 'CTX BOOT BLOCKED: mandatory context did not fit or could not load. Read the required files before acknowledging the current revision or acting.\n'
            boot = pack['text']
        else:
            boot = ctx.boot_pack(r, task, cap)
        ctx.beat(r, task, sid, h, f'start:{src}', extra=extra)
        emit('SessionStart', head + '\n' + boot)
    elif ev == 'prompt':
        u = usage(data)
        if not u:
            return 0
        pct = int(100 * u[0] / max(u[1], 1))
        lvl = next((x for x in LEVELS if pct >= x), 0)
        fire = []

        def gauge(b):
            cur = b.setdefault(rel, {})
            prev = cur.get('gauge_level', 0) if cur.get('gauge_session') == sid else 0
            cur.update(heartbeat=ctx.now(), event='prompt', gauge_pct=pct)
            if sid:
                cur['session'] = sid
            if lvl > prev:
                cur.update(gauge_level=lvl, gauge_session=sid)
                fire.append(lvl)

        ctx.update_beats(r, gauge)
        if fire:
            emit('UserPromptSubmit', NUDGE[lvl].format(pct=pct, start=start, task=rel))
    elif ev == 'pre-compact':
        managed = managed_task(r, task)
        ctx.beat(r, task, sid, h, 'precompact', extra={'checkpoint_needed': bool(managed)})
        if managed:
            print(json.dumps({'systemMessage': f'CTX CHECKPOINT NEEDED: flush observed progress, artifacts, decisions and unfinished work to {ctx.rel(r, managed)}/0 start.md and the managed engine before compaction. Do not invent status or acknowledgement. This hook only requests a checkpoint and does not rewrite the packet or launch a session.'}))
    elif ev == 'stop':
        ctx.beat(r, task, sid, h, 'stop')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # a hook must never break the session
        print(f'ctx-hook: {type(e).__name__}: {e}', file=sys.stderr)
        if os.environ.get('CTX_TASK') or CONFIGURED:
            visible_failure(sys.argv[1] if len(sys.argv) > 1 else '', e)
        sys.exit(0)
