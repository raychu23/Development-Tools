#!/usr/bin/env python3
"""skills map: every live skill by category, linked, own vs ext, what + takeaway · plus the repo list      raymond 2026-10-17
    python3 systems/skills-map          rewrites the map block at the top of skills/0 start.md
    import: table(prefix) → markdown lines (Context/overview.md uses it, prefix '../skills/')
sources: SKILL.md frontmatter · skills/systems/load.txt (ext skills, '# → <category> · <why>') · git clones under skills/      no json"""
import re, subprocess, sys
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
SK = ROOT / 'skills'
START = SK / '0 start.md'
B, E = '<!-- skills map: generated by systems/skills-map, dont hand-edit -->', '<!-- /skills map -->'
ORDER = ['project/sdlc/1-plan', 'project/sdlc/2-understand', 'project/sdlc/3-process', 'project/sdlc/4-verify', 'project/sdlc/5-pr',
         'project/sdlc/6-release', 'project/sdlc/8-ui', 'interview-class/writing', 'interview-class/coursework', 'all/teaching', 'all/system', 'all/tools', 'all/0 new']


def git(*a):
    return subprocess.run(['git', '-C', str(ROOT), *a], capture_output=True, text=True).stdout


def short(folder):
    return re.sub(r'^\d+-', '', Path(folder).name)


def clones():
    """{skills-relative folder: (short name, url)} for every git clone inside skills/"""
    out = {}
    for g in sorted(SK.rglob('.git')):
        d = g.parent
        if d == ROOT or '/.compat/' in str(d) or '/14-sources/' in str(d):  # 14-sources = tool-stack research clones, not skills
            continue
        url = subprocess.run(['git', '-C', str(d), 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
        url = re.sub(r'^(https?://|git@)', '', url).replace('github.com:', 'github.com/').removesuffix('.git')
        out[str(d.relative_to(SK))] = (short(d), url)
    return out


def front(t):
    m = re.match(r'---\r?\n(.*?)\r?\n---', t, re.S)
    h = m.group(1) if m else ''
    get = lambda k: (re.search(rf'^\s*{k}:\s*(.+)$', h, re.M) or [None, ''])[1].strip().strip('"\'')
    return get('name'), get('description'), get('source'), get('takeaway')


def sentences(d):
    s = [x.strip() for x in re.split(r'(?<=[.!?])\s+', d) if x.strip()]
    return (s[0] if s else ''), (' '.join(s[1:]) if len(s) > 1 else '')


def cut(s, n):
    s = s.replace('|', '/').replace('\n', ' ')
    return s if len(s) <= n else s[:n - 1].rsplit(' ', 1)[0] + '…'


def takeaway(folder, why):
    """first real line of the skill's 1 takeaways.md, else metadata takeaway:, else why it was kept (load.txt), else —"""
    f = folder / '1 takeaways.md'
    if f.exists():
        for l in f.read_text(errors='ignore').splitlines():
            l = l.strip()
            if l and not l.startswith(('```', '#')) and len(l) > 20:
                return re.sub(r'\s{2,}', ' · ', l)
    return why if why else '—'


def skills():
    cl = clones()
    rows = []
    for f in git('ls-files', 'skills/**/SKILL.md', 'skills/*/SKILL.md').split():
        rows.append((f.removeprefix('skills/').rsplit('/SKILL.md', 1)[0], None, ''))
    lt = SK / 'systems/load.txt'
    for l in lt.read_text().splitlines() if lt.exists() else []:
        if not l.strip() or l.lstrip().startswith('#'):
            continue
        path, _, note = l.partition('#')
        m = re.match(r'\s*→\s*(\S+)\s*(?:·\s*(.*))?', note)
        rows.append((path.strip(), m.group(1) if m else None, (m.group(2) or '') if m else ''))
    out = []
    for path, cat, why in rows:
        folder = SK / path
        if not (folder / 'SKILL.md').exists():
            continue
        name, desc, src, tk = front((folder / 'SKILL.md').read_text(errors='ignore'))
        repo = next((v[0] for k, v in cl.items() if path.startswith(k + '/')), None)
        frm = f'ext {repo}' if repo else (src if src.startswith('ext ') else 'own')
        if not cat:
            parts = path.split('/')
            cat = '/'.join(parts[:3]) if parts[0] == 'project' else '/'.join(parts[:2])
            if repo:
                cat = '/'.join(next(k for k in cl if path.startswith(k + '/')).split('/')[:3])
        out.append(dict(name=name or folder.name, path=path, cat=cat, frm=frm, what=cut(desc, 150), desc=desc, take=takeaway(folder, tk or why)))
    return out, cl


def ext_vendored(rows):
    """ext skills copied into git (not cloned): repo short name → url from 'source: ext <name> <url>'"""
    out = {}
    for r in rows:
        if r['frm'].startswith('ext ') and len(r['frm'].split()) > 2:
            n, url = r['frm'].split()[1:3]
            out[n] = url
            r['frm'] = f'ext {n}'
    return out


def tree(rows=None):
    """comprehensive scan in raymond's notes style: full folder hierarchy, every skill + repo + source
    columns moving right: name · from · takeaway · full description / when / limits
    do not shorten this view to a quick scan: preserve relevant detail and align every column"""
    rows = rows or ext_vendored_rows()
    _, cl = skills()
    def line(depth, a, b='', c='', d=''):
        return ('    ' * depth + a, b, c, d)
    items = []  # (parent parts, sort key, line maker)
    for r in rows:
        parent = r['cat'].split('/') if r['frm'].startswith('ext ') and r['cat'] else r['path'].split('/')[:-1]
        if r['frm'] == 'own' or not any(r['path'].startswith(k + '/') for k in cl):
            parent = r['path'].split('/')[:-1]
        items.append((parent, (1, r['frm'] != 'own', r['name'].lower()), (r['name'], r['frm'], r['take'] if r['take'] != '—' else '', r['desc'].replace('\\"', '"'))))
    # A comprehensive map includes available but unlinked repo skills too.
    # Keep them at their real full-depth location and label them, not as active.
    live_paths = {r['path'] for r in rows}
    for base, (repo, _) in cl.items():
        for f in sorted((SK / base).rglob('SKILL.md')):
            path = str(f.parent.relative_to(SK))
            if path in live_paths:
                continue
            name, desc, _, tk = front(f.read_text(errors='ignore'))
            items.append((path.split('/')[:-1], (1, True, (name or f.parent.name).lower()),
                          (name or f.parent.name, f'ext {repo} · not linked', takeaway(f.parent, tk), desc)))
    used = {}
    for r in rows:
        if r['frm'].startswith('ext '):
            used[r['frm'][4:]] = used.get(r['frm'][4:], 0) + 1
    for k, (n, url) in cl.items():
        parts = k.split('/')
        u = f'{used[n]} skills linked (listed under their stage)' if used.get(n) else 'clone present, no skill linked; hook / plugin activation not checked here'
        items.append((parts[:-1], (0, 0, parts[-1]), (parts[-1], f'repo {n}', url, u)))
    TOP = ['project', 'interview-class', 'all']
    key = lambda parts: [((TOP.index(x) if x in TOP else 9) if i == 0 else (ORDER.index('/'.join(parts[:i + 1])) if '/'.join(parts[:i + 1]) in ORDER else 99), x) for i, x in enumerate(parts)]
    items.sort(key=lambda it: (key(it[0]), it[1]))
    L = [line(0, 'skills', 'from', 'takeaway  (repo: link)', 'description / when / limits  (repo: status)')]
    seen = set()
    for parent, _, cols in items:
        for i in range(len(parent)):
            t = tuple(parent[:i + 1])
            if t not in seen:
                seen.add(t); L.append(line(i + 1, parent[i]))
        L.append(line(len(parent) + 1, *cols))
    t = START.read_text() if START.exists() else ''
    src = [[c.strip() for c in l.strip('|').split('|')] for l in t.split('## sources', 1)[-1].splitlines() if l.startswith('| ') and not l.startswith('| topic')] if '## sources' in t else []
    if src:
        L.append(line(0, 'sources', 'raymond saved', 'link', 'in the tree?'))
        last = None
        for topic, link, status in src:
            if topic != last:
                L.append(line(1, topic)); last = topic
            m = re.match(r'\[(.*?)\]\((.*?)\)', link)
            L.append(line(2, m.group(1) if m else link, '', m.group(2).removeprefix('https://') if m else '', status))
    nb = re.search(r'^[ \t]*not built yet[ \t]+([^\n]+)$', t, re.M)
    if nb:
        L.append(line(0, 'not built yet'))
        L.extend(line(1, gap.strip(), 'planned') for gap in nb.group(1).split('·'))
    widths = [max(len(row[i]) for row in L) + 4 for i in range(3)]
    return ['```notes'] + [
        (''.join(row[i].ljust(widths[i]) for i in range(3)) + row[3]).rstrip()
        for row in L
    ] + ['```']


def ext_vendored_rows():
    rows, _ = skills()
    ext_vendored(rows)
    return rows


def table(prefix=''):
    rows, cl = skills()
    vend = ext_vendored(rows)
    key = lambda c: (ORDER.index(c) if c in ORDER else len(ORDER), c)
    L = [f'**{len(rows)} skills** · own = written here · ext <repo> = from that repo (list below) · what = its description · takeaway = its 1 takeaways.md (raymond corrections), else its metadata takeaway, else why it was kept, — = none yet', '']
    for c in sorted({r['cat'] for r in rows}, key=key):
        L += [f'#### {c}', '', '| skill | from | what | takeaway |', '|---|---|---|---|']
        for r in sorted((r for r in rows if r['cat'] == c), key=lambda r: (r['frm'] != 'own', r['path'])):
            L.append(f"| [{r['name']}]({prefix}{r['path'].replace(' ', '%20')}/SKILL.md) | {r['frm']} | {r['what']} | {r['take']} |")
        L.append('')
    used = {}
    for r in rows:
        if r['frm'].startswith('ext '):
            used[r['frm'][4:]] = used.get(r['frm'][4:], 0) + 1
    L += ['#### repos', '', '| repo | link | lives in | used as |', '|---|---|---|---|']
    for k, (n, url) in sorted(cl.items(), key=lambda x: x[1][0]):
        u = f'{used[n]} skills linked' if used.get(n) else 'hooks / plugins / reference (no skill linked)'
        L.append(f'| {n} | [{url}](https://{url}) | [{k}]({prefix}{k.replace(" ", "%20")}/) | {u} |')
    for n, url in sorted(vend.items()):
        L.append(f'| {n} | [{url}](https://{url}) | copied in (not a clone) | {used.get(n, 0)} skills |')
    return L


def quick_tree(rows=None):
    """The earlier compact notes layout, kept alongside the comprehensive version."""
    rows = rows or ext_vendored_rows()
    key = lambda c: (ORDER.index(c) if c in ORDER else len(ORDER), c)
    L, seen = ['```notes'], []
    for c in sorted({r['cat'] for r in rows}, key=key):
        parts = c.split('/')
        for i, part in enumerate(parts):
            if parts[:i + 1] not in seen:
                seen.append(parts[:i + 1])
                L.append('    ' * i + part)
        d = '    ' * len(parts)
        for r in sorted((r for r in rows if r['cat'] == c), key=lambda r: (r['frm'] != 'own', r['name'])):
            ext = r['frm'] if r['frm'] != 'own' else ''
            name = (d + r['name']).ljust(48)
            L.append(f"{name}{ext:<22}{r['take'] if r['take'] != '—' else ''}".rstrip())
    L.append('```')
    return L


def main():
    block = '\n'.join([B, '# skills map', '', '## quick scan      earlier compact notes layout', ''] + quick_tree() + ['', '## comprehensive scan      skills + repos + saved sources + planned gaps · full depth · aligned columns, full descriptions', ''] + tree() + ['', '## tables (linked)', ''] + table() + [E])
    t = START.read_text() if START.exists() else ''
    t = re.sub(re.escape(B) + r'.*?' + re.escape(E) + r'\n*', '', t, flags=re.S)
    START.write_text(block + '\n\n' + t.lstrip())
    print(START)


if __name__ == '__main__':
    main()
